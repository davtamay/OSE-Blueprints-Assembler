{
  "assemblies": [
    {
      "id": "assembly_d3d_y_left_bench",
      "name": "Y-Left Axis Bench Build",
      "description": "Assembles the Y-left axis module from individual parts on the workbench: seats linear bearings in the carriage halves, builds the idler with flanged bearing, preps the motor holder with pulley and belt, threads all three units onto the guide rods, routes and pegs the belt, then glues the endstop to the motor holder. Produces a complete, labeled Y-left axis module ready for frame mounting.",
      "machineId": "d3d_v18_10",
      "partGroupIds": [
        "partGroup_y_left_rod_assembly",
        "partGroup_y_left_belt_threading",
        "partGroup_y_left_endstop_build"
      ],
      "stepIds": [
        "step_y_left_rods_into_idler",
        "step_y_left_idler_tighten_rods",
        "step_y_left_carriage_onto_rods",
        "step_y_left_motor_onto_rods",
        "step_y_left_rods_qc",
        "step_y_left_belt_large_hole",
        "step_y_left_belt_around_idler",
        "step_y_left_belt_small_hole",
        "step_y_left_belt_peg_orient",
        "step_y_left_belt_first_peg",
        "step_y_left_belt_second_peg",
        "step_y_left_belt_travel_test",
        "step_y_left_label_axis",
        "step_y_left_endstop_gather",
        "step_y_left_endstop_slide",
        "step_y_left_endstop_glue_board",
        "step_y_left_endstop_prep_motor",
        "step_y_left_endstop_attach",
        "step_y_left_endstop_reinforce",
        "step_y_left_compose_axis",
        "step_qc_y_left_axis_bench"
      ],
      "dependencyAssemblyIds": [
        "assembly_d3d_frame",
        "assembly_d3d_batch_carriage_build",
        "assembly_d3d_batch_idler_build",
        "assembly_d3d_batch_motor_build"
      ],
      "learningFocus": "Carriage bearing fit and belt-hole alignment, idler bearing and rod-hole alignment, motor pulley press-fit and belt channel, rod threading order (idler \u00e2\u2020\u2019 carriage \u00e2\u2020\u2019 motor holder), belt routing and peg locking, endstop gluing, and full bench QC before frame mounting."
    }
  ],
  "partGroups": [
    {
      "id": "partGroup_y_left_rod_assembly",
      "name": "Y-Left Axis Rod Assembly",
      "stepIds": [
        "step_y_left_rods_into_idler",
        "step_y_left_idler_tighten_rods",
        "step_y_left_carriage_onto_rods",
        "step_y_left_motor_onto_rods",
        "step_y_left_rods_qc"
      ],
      "assemblyId": "assembly_d3d_y_left_bench",
      "description": "Inserts the two guide rods into the completed idler (rods flush with idler bottom), slides the carriage onto the rods (long bolt ends closer to idler), then pushes the motor holder onto the rods (motor facing the carriage bolt heads). Tightens the idler's two shorter bolts. Checks rods are still flush with idler bottom.",
      "milestoneMessage": "Y-left guide rods threaded through idler \u00e2\u2020\u2019 carriage \u00e2\u2020\u2019 motor holder with rods flush at idler."
    },
    {
      "id": "partGroup_y_left_belt_threading",
      "name": "Y-Left Belt Threading",
      "assemblyId": "assembly_d3d_y_left_bench",
      "description": "Inserts one belt end through the larger carriage belt hole, routes it around the idler bearing (slight curve helps), pulls through the smaller carriage belt hole. Threads through first peg (foot facing away from axis center), inserts belt end ~\u00c2\u00be inch and pushes peg into ribbed hole. Places second peg loosely \u00e2\u20ac\u201d it will be tightened after frame mounting when the full belt length is confirmed.",
      "partIds": [
        "idler002",
        "idler002_half_b"
      ],
      "stepIds": [
        "step_y_left_belt_large_hole",
        "step_y_left_belt_around_idler",
        "step_y_left_belt_small_hole",
        "step_y_left_belt_peg_orient",
        "step_y_left_belt_first_peg",
        "step_y_left_belt_second_peg",
        "step_y_left_belt_travel_test",
        "step_y_left_label_axis"
      ],
      "milestoneMessage": "Y-left belt routed and first peg locked. Second peg loose for frame-side tensioning.",
      "isAggregate": true
    },
    {
      "id": "partGroup_y_left_endstop_build",
      "name": "Y-Left Endstop Attachment",
      "stepIds": [
        "step_y_left_endstop_gather",
        "step_y_left_endstop_slide",
        "step_y_left_endstop_glue_board",
        "step_y_left_endstop_prep_motor",
        "step_y_left_endstop_attach",
        "step_y_left_endstop_reinforce"
      ],
      "assemblyId": "assembly_d3d_y_left_bench",
      "description": "Slides endstop board into holder crevice with switch arm facing the arrowhead direction, bottom flush with holder bottom. Dabs super glue into top-left and bottom-left motor-piece holes facing the belt. Presses and holds the endstop holder against the motor piece. Adds reinforcing glue along the holder edges. Labels axis Y-Left with masking tape.",
      "milestoneMessage": "Y-left axis complete: endstop glued, QC passed (belt smooth, rods flush, bolt heads same side, belt toothed side inward), axis labeled."
    },
    {
      "id": "partGroup_y_left_bench_unit",
      "name": "Y Left Complete Axis Unit",
      "assemblyId": "assembly_d3d_y_left_bench",
      "description": "The fully assembled y left axis unit, ready for staging. Contains all bench-built components: carriage, idler, motor holder, rods, and belt.",
      "partIds": [
        "y_left_carriage_half_a",
        "y_left_carriage_half_b",
        "idler002",
        "idler002_half_b",
        "motor002",
        "rod_005",
        "rod_006",
        "y1_bracket",
        "pocket039",
        "pocket040",
        "y_endstop"
      ],
      "stepIds": [
        "step_y_left_compose_axis"
      ],
      "isAggregate": true
    }
  ],
