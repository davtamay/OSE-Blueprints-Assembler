    {
      "id": "step_y_left_endstop_slide",
      "name": "Slide endstop board into holder crevice",
      "assemblyId": "assembly_d3d_y_left_bench",
      "partGroupId": "partGroup_y_left_endstop_build",
      "sequenceIndex": 202,
      "family": "Place",
      "instructionText": "Slide the endstop board into the crevice of the holder piece. The switch arm must face toward the arrowhead direction of the holder, away from the mounting legs. The bottom of the board should be flush with the bottom of the holder."
    },
    {
      "id": "step_y_left_endstop_glue_board",
      "name": "Super glue endstop into holder",
      "assemblyId": "assembly_d3d_y_left_bench",
      "partGroupId": "partGroup_y_left_endstop_build",
      "sequenceIndex": 203,
      "family": "Confirm",
      "instructionText": "Dab super glue along the side edges of the crevice. Do not apply glue to the metal switch arm or any board contacts."
    },
    {
      "id": "step_y_left_endstop_prep_motor",
      "name": "Prep motor holder holes for endstop",
      "assemblyId": "assembly_d3d_y_left_bench",
      "partGroupId": "partGroup_y_left_endstop_build",
      "sequenceIndex": 204,
      "family": "Confirm",
      "instructionText": "Dab super glue into the two motor holder holes facing the belt (top-left and bottom-left when the motor faces you)."
    },
    {
      "id": "step_y_left_endstop_attach",
      "name": "Press endstop holder onto motor holder",
      "assemblyId": "assembly_d3d_y_left_bench",
      "partGroupId": "partGroup_y_left_endstop_build",
      "sequenceIndex": 205,
      "family": "Place",
      "instructionText": "Press and hold the endstop holder piece firmly against the motor holder piece for at least 30 seconds until bonded."
    },
    {
      "id": "step_y_left_endstop_reinforce",
      "name": "Reinforce endstop joint with super glue",
      "assemblyId": "assembly_d3d_y_left_bench",
      "partGroupId": "partGroup_y_left_endstop_build",
      "sequenceIndex": 206,
      "family": "Confirm",
      "instructionText": "Add super glue along all joint edges between the endstop holder and the motor holder to strengthen the connection."
    },
