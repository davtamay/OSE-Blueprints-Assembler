      "family": "Place",
      "requiredPartGroupId": "partGroup_y_right_bench_unit",
      "targetIds": [
        "target_y_right_bench_staged"
      ],
      "instructionText": "All Y-Right axis components are assembled. Pick up the completed axis unit and place it at the staging position on your bench. It sits here until frame mounting.",
      "sequenceIndex": 274
    },
    {
      "id": "step_qc_y_right_axis_bench",
      "name": "Y-Right axis bench QC and label",
      "assemblyId": "assembly_d3d_y_right_bench",
      "partGroupId": "partGroup_y_right_bench_unit",
      "sequenceIndex": 338,
      "family": "Confirm",
      "viewMode": "Inspect",
      "instructionText": "Run the full bench QC checklist before labeling and setting aside: belt moves smoothly along the full rod length; rod ends are flush with the idler bottom; the idler and carriage bolt heads are on the same side; the toothed side of the belt is facing inward. Label the axis Y-Right using masking tape and a marker.",
      "targetIds": [
        "target_bench_y_right_qc"
      ],
      "hintIds": [
        "hint_qc_y_right_axis_bench"
      ]
    }
