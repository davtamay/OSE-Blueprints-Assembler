{
  "assemblies": [
    {
      "id": "assembly_d3d_y_right_bench",
      "name": "Y-Right Axis Bench Build",
      "description": "Assembles the Y-right axis module from individual parts using the same procedure as Y-left. Y-right and Z-Front share the same plastic piece type \u2014 build instructions are identical. Note the slight orientation differences in motor cable direction and long-bolt position. Produces a labeled Y-right axis module ready for frame mounting.",
      "machineId": "d3d_v18_10",
      "partGroupIds": [
        "partGroup_y_right_bench_unit"
      ],
      "stepIds": [
        "step_y_right_compose_axis",
        "step_qc_y_right_axis_bench"
      ],
      "dependencyAssemblyIds": [
        "assembly_d3d_frame",
        "assembly_d3d_batch_carriage_build",
        "assembly_d3d_batch_idler_build",
        "assembly_d3d_batch_motor_build",
        "assembly_d3d_batch_rod_assembly",
        "assembly_d3d_batch_belt_threading"
      ],
      "learningFocus": "Same bench-build sequence as Y-left: carriage bearing shake and rod-slide tests, idler rod-hole alignment, motor pulley pop-check, rod threading order, belt routing and first peg locked. Note: long M6x30 bolt is in bottom-left of motor half-piece (not top), and motor cable plug faces the belt drive hole."
    }
  ],
