    {
      "id": "step_z_back_idler_tighten_rods",
      "name": "Tighten short idler bolts onto rods",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_rod_assembly",
      "sequenceIndex": 238,
      "family": "Use",
      "instructionText": "Tighten the two shorter idler bolts with an electric drill to grip the rods firmly. Leave the longer bolt loose \u2014 it will be used to attach the axis to the frame."
    },
    {
      "id": "step_z_back_carriage_onto_rods",
      "name": "Slide carriage onto rods",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_rod_assembly",
      "sequenceIndex": 239,
      "family": "Place",
      "instructionText": "Slide the already-assembled Z-back carriage onto the rods with the long bolt ends closer to the idler. This orientation maximizes the Z-axis travel. The carriage was built earlier in the batch carriage stage \u2014 no new parts to place.",
