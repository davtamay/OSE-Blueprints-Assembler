    {
      "id": "step_z_back_rods_qc",
      "name": "QC: rods flush, carriage slides freely",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_rod_assembly",
      "sequenceIndex": 241,
      "family": "Confirm",
      "instructionText": "Check that rod ends are still flush at the idler bottom. Slide the carriage the full rod length \u2014 it should move with only slight bearing resistance."
    },
    {
      "id": "step_z_back_compose_axis",
      "name": "Stage completed Z-Back axis on bench",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_bench_unit",
      "family": "Place",
      "requiredPartGroupId": "partGroup_z_back_bench_unit",
      "targetIds": [
        "target_z_back_bench_staged"
      ],
      "instructionText": "Z-Back axis assembly is complete. Place the assembled axis unit at the staging position on your bench. It mounts to the back face of the frame.",
      "sequenceIndex": 287
    },
    {
      "id": "step_z_back_belt_large_hole",
      "name": "Thread belt through large carriage hole",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_belt_threading",
      "sequenceIndex": 288,
      "family": "Place",
      "instructionText": "Inspect the carriage: one belt hole is large and smooth, the other small and ribbed. Insert one belt end through the large smooth hole with the toothed side facing inward.",
      "requiredPartIds": []
    },
    {
      "id": "step_z_back_belt_around_idler",
      "name": "Route belt around idler bearing",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_belt_threading",
      "sequenceIndex": 289,
      "family": "Place",
      "instructionText": "Feed the belt around the bearing inside the idler. Tip: curve the belt slightly in the direction of travel first \u00e2\u20ac\u201d it navigates around the bearing more easily.",
      "requiredPartIds": []
    },
    {
      "id": "step_z_back_belt_small_hole",
      "name": "Thread belt back through small carriage hole",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_belt_threading",
      "sequenceIndex": 290,
      "family": "Place",
      "instructionText": "Once the belt is around the idler bearing, pull it back through the smaller ribbed carriage hole.",
      "requiredPartIds": []
    },
    {
      "id": "step_z_back_belt_peg_orient",
      "name": "Confirm belt peg orientation before locking",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_belt_threading",
      "sequenceIndex": 291,
      "family": "Confirm",
      "instructionText": "Thread the belt end through a belt peg. Confirm: the foot of the peg faces away from the toothed side of the belt and away from the axis center. Wrong orientation prevents the peg from locking correctly.",
      "requiredPartIds": []
    },
    {
      "id": "step_z_back_belt_first_peg",
      "name": "Lock first belt peg",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_belt_threading",
      "sequenceIndex": 292,
      "family": "Use",
      "instructionText": "Insert the belt end approximately 3/4 inch into the small ribbed belt hole, then simultaneously insert the peg into the same hole and press firmly until it locks.",
      "requiredPartIds": []
    },
    {
      "id": "step_z_back_belt_second_peg",
      "name": "Insert second peg loosely",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_belt_threading",
      "sequenceIndex": 293,
      "family": "Place",
      "instructionText": "Insert the second peg directly across from the first. Hand-tighten the belt by pulling it through the first peg as much as you can easily. Leave the second peg loose \u00e2\u20ac\u201d it will be fully tensioned after mounting to the frame.",
      "requiredPartIds": []
    },
    {
      "id": "step_z_back_belt_travel_test",
      "name": "Travel test: carriage moves smoothly with belt",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_belt_threading",
      "sequenceIndex": 294,
      "family": "Confirm",
      "instructionText": "Slide the carriage along the full rod length with the belt installed. It should move smoothly without binding. If it binds, check the belt is not twisted and both carriage holes are correctly threaded.",
      "requiredPartIds": []
    },
    {
      "id": "step_z_back_label_axis",
      "name": "Label completed Z-Back Axis and set aside",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_belt_threading",
      "sequenceIndex": 295,
      "family": "Confirm",
      "instructionText": "Use masking tape and a marker to label this assembly as \"Z-Back Axis\". Set it aside in a safe place. It is complete and ready for frame mounting.",
      "requiredPartIds": []
    },
    {
      "id": "step_qc_z_back_axis_bench",
      "name": "Z-Back axis bench QC and label",
      "assemblyId": "assembly_d3d_z_back_bench",
      "partGroupId": "partGroup_z_back_belt_threading",
      "sequenceIndex": 333,
      "family": "Confirm",
      "viewMode": "Inspect",
      "instructionText": "Run the full bench QC checklist before labeling and setting aside: belt moves smoothly along the full rod length; rod ends are flush with the idler bottom; the idler and carriage bolt heads are on the same side; the toothed side of the belt is facing inward. Label the axis Z-Back using masking tape and a marker.",
      "targetIds": [
        "target_bench_z_back_qc"
      ],
      "hintIds": [
        "hint_qc_z_back_axis_bench"
      ]
    }
  ],
